MONGO_URI=mongodb://localhost:27017/volunteer-hub
# "development" adds the error message and stack to API error responses.
NODE_ENV=development
SESSION_SECRET=change-me-in-production
PORT=3000
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Facebook Page that announces new events. Both values come from the Page
# access token setup - see backend/scripts/facebook-test.js.
# Leave blank to disable announcements.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional. Pins the Graph API version, otherwise v25.0 is used.
FACEBOOK_GRAPH_VERSION=
